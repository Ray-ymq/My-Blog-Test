---
import BaseLayout from '@/layouts/BaseLayout.astro';
import PostCard from '@/components/PostCard.astro';
import { getAllTags, getPublishedPosts } from '@/lib/content';

export async function getStaticPaths() {
  const posts = await getPublishedPosts();
  const tags = getAllTags(posts);

  return tags.map((tag) => ({
    params: { tag },
    props: { tag, posts: posts.filter((post) => post.data.tags.includes(tag)) }
  }));
}

const { tag, posts } = Astro.props;
---

<BaseLayout title={`标签：${tag}`} description={`浏览 ${tag} 标签下的文章。`}>
  <section class="shell section">
    <div class="section-head">
      <div>
        <p class="eyebrow">Tag</p>
        <h1>{tag}</h1>
        <p class="lead">共 {posts.length} 篇文章。</p>
      </div>
      <a class="button" href="/blog/">返回文章列表</a>
    </div>
    <div class="post-list">
      {posts.map((post) => <PostCard post={post} />)}
    </div>
  </section>
</BaseLayout>
