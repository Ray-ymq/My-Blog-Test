---
import BaseLayout from '@/layouts/BaseLayout.astro';
import PostCard from '@/components/PostCard.astro';
import { siteConfig } from '@/config/site';
import { getAllTags, getPublishedPosts } from '@/lib/content';

const posts = await getPublishedPosts();
const latestPosts = posts.slice(0, 3);
const tags = getAllTags(posts);
---

<BaseLayout title={siteConfig.title} description={siteConfig.description}>
  <section class="shell hero">
    <div>
      <p class="eyebrow">Personal Blog</p>
      <h1>持续记录，认真复盘。</h1>
      <p class="lead">
        {siteConfig.description} 当前是第一版静态博客，后续可以直接接入云服务器和域名。
      </p>
      <div class="actions">
        <a class="button primary" href="/blog/">阅读文章</a>
        <a class="button" href="/about/">了解我</a>
      </div>
    </div>
    <aside class="profile-panel" aria-label="作者信息">
      <img src={siteConfig.avatar} alt={`${siteConfig.author} 的头像`} width="96" height="96" />
      <h2>{siteConfig.author}</h2>
      <p>{siteConfig.title}</p>
      <div class="social-links" style="margin-top: 18px;">
        {siteConfig.socials.map((item) => <a class="tag" href={item.href}>{item.label}</a>)}
      </div>
    </aside>
  </section>

  <section class="shell section">
    <div class="section-head">
      <div>
        <p class="eyebrow">Latest</p>
        <h2>最新文章</h2>
      </div>
      <a class="button" href="/blog/">全部文章</a>
    </div>
    <div class="post-grid">
      {latestPosts.map((post) => <PostCard post={post} />)}
    </div>
  </section>

  <section class="shell section">
    <div class="section-head">
      <div>
        <p class="eyebrow">Tags</p>
        <h2>按标签浏览</h2>
      </div>
    </div>
    <div class="tag-list">
      {tags.map((tag) => <a class="tag" href={`/tags/${encodeURIComponent(tag)}/`}>{tag}</a>)}
    </div>
  </section>
</BaseLayout>
